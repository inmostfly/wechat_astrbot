# 大模型：沿用父项目同名配置；也可以在本目录创建 .env 覆盖父项目。
API_KEY_2=
API_URL_2=
MODEL_2=deepseek-v4-flash

# 可选：和风天气 MCP。留空时，模型仍可聊天，但天气工具加载会失败。
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 联网搜索。auto 会优先使用 Tavily，其次使用 SearXNG。
# 读取用户给出的公开网址不需要搜索后端或 API Key。
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
SEARXNG_URL=
SEARXNG_API_KEY=

# 默认 false：网页读取只允许公网地址。
# 设为 true 后允许可信内网和 Clash Fake-IP，仍阻止本机回环及云元数据地址。
WEB_ALLOW_PRIVATE_ADDRESS=false

# iLink 运行参数。通常无需修改。
ILINK_API_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_BOT_TYPE=3
ILINK_SKIP_INITIAL_MESSAGES=true
ILINK_MAX_HISTORY=30
ILINK_MAX_REPLY_CHARS=1800

# SQLite 定时提醒。默认值适合中国时区和微信 ClawBot 当前限制。
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_ACTIVE_HOURS=24
REMINDER_OUTBOUND_LIMIT=10
REMINDER_CHECK_INTERVAL_SECONDS=1

# 24小时会话保活问候。默认在最后一次入站消息23小时后随机询问一次。
# 提前一小时是为了避免刚好卡在微信24小时窗口边缘。
CHECKIN_ENABLED=true
CHECKIN_AFTER_HOURS=23

# Windows 双击启动遇到致命错误时，是否等待按回车再退出。
PAUSE_ON_ERROR=true
