# 大模型：沿用父项目同名配置；也可以在本目录创建 .env 覆盖父项目。
API_KEY_2=
API_URL_2=
MODEL_2=deepseek-v4-flash

# 图片消息专用模型。只在收到微信图片时调用，文字聊天仍使用 MODEL_2。
VISION_MODEL_2=deepseek-v4-flash-vision-exp

# 可选：和风天气 MCP。留空时，模型仍可聊天，但天气工具加载会失败。
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 联网搜索。auto 会优先使用 Tavily，其次使用 SearXNG。
# 读取用户给出的公开网址不需要搜索后端或 API Key。
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
SEARXNG_URL=
SEARXNG_API_KEY=

# 默认 false：网页读取只允许公网地址。
# 设为 true 后允许可信内网和 Clash Fake-IP，仍阻止本机回环及云元数据地址。
WEB_ALLOW_PRIVATE_ADDRESS=false

# iLink 运行参数。通常无需修改。
ILINK_API_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_BOT_TYPE=3
ILINK_SKIP_INITIAL_MESSAGES=true
ILINK_MAX_HISTORY=30
ILINK_MAX_REPLY_CHARS=1800
# 图片在内存中下载、解密并临时发送给视觉模型，不写入磁盘或长期上下文。
ILINK_MAX_IMAGES_PER_MESSAGE=4
ILINK_MAX_IMAGE_BYTES=10485760
# 文件先在内存中解密，再由文档 MCP 提取文字。不会把原始文件写入磁盘。
ILINK_MAX_FILES_PER_MESSAGE=3
ILINK_MAX_FILE_BYTES=15728640
ILINK_MAX_DOCUMENT_CHARS=60000
ILINK_MAX_DOCUMENT_TOTAL_CHARS=120000
# 文档 MCP 自身的安全上限；通常保持与 ILINK_MAX_FILE_BYTES 一致。
DOCUMENT_MCP_MAX_BYTES=15728640
DOCUMENT_MCP_MAX_CHARS=60000
DOCUMENT_MCP_MAX_PAGES=300
DOCUMENT_MCP_MAX_SHEET_ROWS=5000

# SQLite 定时提醒。默认值适合中国时区和微信 ClawBot 当前限制。
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_ACTIVE_HOURS=24
REMINDER_OUTBOUND_LIMIT=10
REMINDER_CHECK_INTERVAL_SECONDS=1

# 24小时会话保活问候。默认在最后一次入站消息23小时后随机询问一次。
# 提前一小时是为了避免刚好卡在微信24小时窗口边缘。
CHECKIN_ENABLED=true
CHECKIN_AFTER_HOURS=23

# Windows 双击启动遇到致命错误时，是否等待按回车再退出。
PAUSE_ON_ERROR=true
# 可选：通用外部 stdio MCP 配置；相对路径按程序目录解析
ILINK_MCP_CONFIG=mcp_servers.json

# 只读邮箱 MCP 与新邮件微信通知。默认关闭；启用后不会把邮件标记已读或删除。
# Gmail 可使用 imap.gmail.com:993。password 模式下填写 Google 应用专用密码，
# 不要填写 Google 账号的普通登录密码；也可选 xoauth2 并提供短期访问令牌。
EMAIL_MCP_ENABLED=false
EMAIL_MONITOR_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_AUTH=password
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_OAUTH_ACCESS_TOKEN=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_TIMEOUT_SECONDS=20
EMAIL_IMAP_MAX_DOWNLOAD_BYTES=5242880
EMAIL_MAX_BODY_CHARS=2000
EMAIL_POLL_INTERVAL_SECONDS=120
EMAIL_BATCH_SIZE=5
# true 表示首次启用时只建立游标，不转发邮箱里已有的旧邮件。
EMAIL_SKIP_EXISTING=true
